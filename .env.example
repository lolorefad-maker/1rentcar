# ==============================================================================
# Production Environment Configuration
# ==============================================================================

# Port the Express server listens on
PORT=3000

# Production environment mode (activates rate limiters, security and optimized caching)
NODE_ENV=production

# Strong, unique master password for the Admin Dashboard (CHANGE THIS!)
ADMIN_PASSWORD=change_this_to_a_very_strong_password_123!

# Business Timezone (used for daily rates, booking dates and calendar hours)
BUSINESS_TIMEZONE=Asia/Amman

# Database path (optional, defaults to ./showroom.db)
# DB_PATH=/var/data/showroom.db
